# Copy this file to .env and fill in real values before running the server.
# Run the server with:  node --env-file=.env server.js

# Required. 32-byte encryption key, base64-encoded. Generate one with:
#   node lib/gen-key.js
# Keep this secret and back it up somewhere safe — if you lose it, every
# encrypted report/opinion/decision in the database becomes unreadable forever.
KULAKTAN_MASTER_KEY=

# Port the server listens on.
PORT=3000

# Optional. Where the SQLite database file lives. Defaults to ./data/kulaktan.db
# KULAKTAN_DB_PATH=./data/kulaktan.db

# Optional. Real email sending via Resend (https://resend.com). Without this,
# emails are logged in the admin panel but not actually sent — and the full
# content (including password-reset links) is printed to the server console
# instead, so you can still test/use the app before setting up a real provider.
# RESEND_API_KEY=
# EMAIL_FROM=Kulaktan <bildirim@kulaktan.com.tr>
# COMPLIANCE_EMAIL=compliance@kulaktan.com.tr
# BOARD_EMAIL=board@kulaktan.com.tr
# CONTACT_EMAIL=info@kulaktan.com.tr

# Used to build password-reset links in emails. Set this to your real
# public URL in production.
APP_BASE_URL=http://localhost:3000
# Production example:
# APP_BASE_URL=https://kulaktan.com.tr

# Set this in production (enables the Secure flag on cookies — requires HTTPS).
# NODE_ENV=production
